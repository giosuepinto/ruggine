
# ===================================================================
# File .gitignore per il Progetto Ruggine (Rust + React)
# ===================================================================

# --------------------------------------------------
# 1. Backend RUST (ruggine_server)
# --------------------------------------------------
/ruggine_server/target/
/ruggine_server/ruggine.db
/ruggine_server/ruggine.db-journal
/ruggine_server/ruggine.db-wal
/ruggine_server/*.log

# --------------------------------------------------
# 2. Frontend REACT (ruggine_client)
# --------------------------------------------------
/ruggine_client/node_modules/
/ruggine_client/package-lock.json
/ruggine_client/dist/
/ruggine_client/.vite/
/ruggine_client/bootstrap/
/ruggine_client/react-bootstrap/
/ruggine_client/.npm/
/ruggine_client/npm-debug.log*
/ruggine_client/yarn-debug.log*
/ruggine_client/yarn-error.log*
/ruggine_client/pnpm-debug.log*
/ruggine_client/*.tmp
/ruggine_client/*.temp
/ruggine_client/.vscode/
/ruggine_client/.idea/
/ruggine_client/.DS_Store

# --------------------------------------------------
# 3. Manuali LaTeX (manuali)
# --------------------------------------------------
manuali/**/build/

# --------------------------------------------------
# File di Sistema e IDE (globali)
# --------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --------------------------------------------------
# File di Ambiente e segreti
# --------------------------------------------------
.env
.env.*
!.env.example
